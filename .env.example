# PostgreSQL connection — BM360 Bharat Mandapam portal
# Copy to .env and adjust for your environment
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=bm360
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bm360

# Session signing secret — generate a random hex string for production
SESSION_SECRET=change-me-to-a-long-random-string
